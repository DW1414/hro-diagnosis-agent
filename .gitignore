# ===== 程序与知识库版本库（GitHub Pages 托管）=====
# 原则：只发程序，不发运行时数据；知识库运行时数据永远只在本机浏览器

# 依赖与临时产物
node_modules/
_build/node_modules/
_build/_site_test/
_build/_tu.log
_site_test/

# 本地截图与调试日志（不入库，避免仓库膨胀）
_build/*.png
_build/*.log
*.tmp

# 项目工作区数据（WorkBuddy 本地记忆，非代码）
.workbuddy/

# 系统垃圾
.DS_Store
Thumbs.db
desktop.ini

# 本地 Python 缓存
__pycache__/
*.pyc

# 一次性排查脚本与临时数据（保留 test_*.js 与 shot_*.js 作为验证资产）
_build/_probe*.js
_build/repro*.js
_build/dbg*.js
_build/check_*.js
_build/mock_last.json
_build/kb_dump.json
